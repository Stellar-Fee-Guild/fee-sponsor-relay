# --- Stellar network ---
# Horizon endpoint to submit transactions to.
HORIZON_URL=https://horizon-testnet.stellar.org
# Network passphrase must match HORIZON_URL (Public, Testnet, Futurenet, or a private network).
NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# --- Sponsor account ---
# Secret key (S...) of the account that pays fee-bump fees.
# Prefer SPONSOR_SECRET_KEY_FILE in production so the key never lives in
# process env / shell history / process listings; the relay reads it from a
# file (e.g. a mounted secret from Docker/Kubernetes/Vault) instead.
SPONSOR_SECRET_KEY=
# Path to a file containing only the sponsor secret key. Takes precedence
# over SPONSOR_SECRET_KEY when set.
SPONSOR_SECRET_KEY_FILE=

# --- HTTP server ---
PORT=3000
LOG_LEVEL=info

# --- Policy: allow/deny lists ---
# Comma-separated list of source account public keys (G...) allowed to
# request sponsorship. Leave empty to allow any account not on the denylist.
POLICY_ALLOWLIST=
# Comma-separated list of source account public keys that are always rejected.
POLICY_DENYLIST=

# --- Policy: fee and cap limits (in stroops, 1 XLM = 10,000,000 stroops) ---
POLICY_MAX_FEE_STROOPS_PER_TX=1000000
POLICY_HOURLY_CAP_STROOPS_PER_ACCOUNT=5000000
POLICY_DAILY_CAP_STROOPS_PER_ACCOUNT=20000000

# --- Policy: transaction validity window ---
# Maximum number of seconds in the future an inner transaction's maxTime may
# be. The sponsor's signature is valid for as long as the inner transaction
# is, so without a limit a client could hold a sponsored fee bump and submit
# it much later (after you've changed policy or budgets). Inner transactions
# with no maxTime, maxTime=0 (infinite timeout) or a later maxTime are
# rejected with INVALID_INNER_TRANSACTION.
POLICY_MAX_TX_VALIDITY_SECONDS=300

# --- Rate limiting ---
RATE_LIMIT_PER_ACCOUNT_PER_MINUTE=10
RATE_LIMIT_PER_IP_PER_MINUTE=30
